# Agentic wallet configuration for x402 payments
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control

# EVM private key for the agent wallet (0x-prefixed hex)
# This key signs x402 payment authorizations on Base (USDC).
# Fund the corresponding address with USDC on Base mainnet to enable payments.
# Generate a fresh key with (WARNING: clears terminal output immediately after):
#   python -c "from eth_account import Account; a = Account.create(); print(a.key.hex(), a.address)"
# Then paste only the 0x... private key below and clear your shell history.
EVM_PRIVATE_KEY=
